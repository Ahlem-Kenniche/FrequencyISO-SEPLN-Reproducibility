PREFIX prolex: <https://prolexbase.univ-oran.dz/ontology#>

SELECT ?language ?year ?level WHERE { ?entry prolex:isLexicalEntryOf prolex:Pivot_64621 ; prolex:hasLanguage ?language ; prolex:hasTemporalFrequency ?obs . VALUES ?language { prolex:Language_arb prolex:Language_eng prolex:Language_fra } ?obs prolex:yearValue ?year ; prolex:sourceFrequencyCode ?level . FILTER(?year >= 2019 && ?year <= 2023) FILTER(?level IN (1,2,3)) } ORDER BY ?language ?year
