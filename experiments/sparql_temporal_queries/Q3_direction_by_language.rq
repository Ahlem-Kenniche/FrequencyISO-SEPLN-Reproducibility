PREFIX prolex: <https://prolexbase.univ-oran.dz/ontology#>

SELECT ?language (COUNT(DISTINCT ?upEntry) AS ?upward) (COUNT(DISTINCT ?downEntry) AS ?downward) WHERE { ?entry prolex:hasLanguage ?language ; prolex:hasTemporalFrequency ?o22 ; prolex:hasTemporalFrequency ?o23 . ?o22 prolex:yearValue 2022 ; prolex:sourceFrequencyCode ?l22 . ?o23 prolex:yearValue 2023 ; prolex:sourceFrequencyCode ?l23 . FILTER(?l22 IN (1,2,3) && ?l23 IN (1,2,3) && ?l22 != ?l23) BIND(IF(?l23 < ?l22, ?entry, 1/0) AS ?upEntry) BIND(IF(?l23 > ?l22, ?entry, 1/0) AS ?downEntry) } GROUP BY ?language ORDER BY ?language
